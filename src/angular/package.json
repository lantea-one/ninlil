{
  "name": "angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "npm run generate:api",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fetch:openapi": "curl -sf http://localhost:5000/swagger/v1/swagger.json -o openapi/swagger.json",
    "generate:api": "openapi-generator-cli generate -i openapi/swagger.json -g typescript-angular -o src/app/api-client --additional-properties=ngVersion=22.0.0,npmName=ninlil-api-client,serviceSuffix=Service,providedInRoot=true,withInterfaces=true,useSingleRequestParameter=true --skip-validate-spec"
  },
  "private": true,
  "packageManager": "npm@12.0.2",
  "dependencies": {
    "@angular/animations": "^22.1.4",
    "@angular/cdk": "^22.1.4",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@coreui/angular": "^5.7.24",
    "@coreui/coreui": "^5.9.0",
    "@coreui/icons": "^3.1.0",
    "@coreui/icons-angular": "^5.7.24",
    "@microsoft/signalr": "^10.0.11",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.1.6",
    "@angular-eslint/eslint-plugin": "^22.2.0",
    "@angular-eslint/eslint-plugin-template": "^22.2.0",
    "@angular-eslint/template-parser": "^22.2.0",
    "@angular/build": "^22.0.1",
    "@angular/cli": "^22.0.1",
    "@angular/compiler-cli": "^22.0.0",
    "@eslint/js": "^10.0.1",
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "@types/jasmine": "^6.0.0",
    "angular-eslint": "^22.2.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "jasmine-core": "^7.0.2",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.68.0"
  }
}
