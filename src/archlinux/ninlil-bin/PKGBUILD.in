# Maintainer: Freja Abigail <frejagail@gmail.com>
#
# Generated by the Ninlil pipeline for @VERSION@ (.forgejo/scripts/arch-packages.sh) from
# src/archlinux/ninlil-bin/PKGBUILD.in; edit the template, not this file.

pkgname=ninlil-bin
pkgver=@PKGVER@
pkgrel=1
pkgdesc='DNS, DHCPv4/DHCPv6 and Router Advertisement server with a REST API and web admin console (release binary)'
arch=('x86_64' 'aarch64')
url='https://git.lantea.one/Lantea.One/ninlil'
license=('MIT')
depends=('glibc' 'gcc-libs' 'icu' 'openssl')
optdepends=('msquic: DNS-over-QUIC transport')
provides=('ninlil')
conflicts=('ninlil')
backup=('etc/ninlil/ninlil.env')
# A .NET single-file executable carries its payload after the ELF image; stripping it corrupts it.
options=('!strip' '!debug')
_release="${url}/releases/download/@TAG_PATH@"
source=('ninlil.service' 'ninlil.sysusers' 'ninlil.env' 'LICENSE')
source_x86_64=("ninlil-${pkgver}-x86_64::${_release}/ninlil-linux-amd64")
source_aarch64=("ninlil-${pkgver}-aarch64::${_release}/ninlil-linux-arm64")
sha256sums=('@SHA256_SERVICE@'
            '@SHA256_SYSUSERS@'
            '@SHA256_ENV@'
            '@SHA256_LICENSE@')
sha256sums_x86_64=('@SHA256_X86_64@')
sha256sums_aarch64=('@SHA256_AARCH64@')

package() {
  install -Dm755 "ninlil-${pkgver}-${CARCH}" "${pkgdir}/usr/lib/ninlil/ninlil"
  # The server keeps its data directory next to the executable; point it at the state directory.
  ln -s /var/lib/ninlil "${pkgdir}/usr/lib/ninlil/data"
  # An empty web root: the admin console is served from inside the executable, but ASP.NET Core
  # would otherwise try to create the web root it is given in the read-only /usr/lib.
  install -dm755 "${pkgdir}/usr/lib/ninlil/wwwroot"
  install -Dm644 ninlil.service "${pkgdir}/usr/lib/systemd/system/ninlil.service"
  install -Dm644 ninlil.sysusers "${pkgdir}/usr/lib/sysusers.d/ninlil.conf"
  install -Dm640 ninlil.env "${pkgdir}/etc/ninlil/ninlil.env"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
