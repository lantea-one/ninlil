# Environment for the ninlil service. Every setting Ninlil reads can be set here with its
# NINLIL_-prefixed name; see ENVIRONMENT.md in the Ninlil repository for the complete list.
#
# The bootstrap administrator's generated password is printed once to the journal on first start
# (journalctl -u ninlil); set it here instead to choose it yourself:
#NINLIL_IDENTITY_BOOTSTRAP_ADMINISTRATOR_PASSWORD=Change-Me-Now1!
#
# SQLite in /var/lib/ninlil is the default; for another engine:
#NINLIL_STORAGE_ENGINE=PostgreSql
#NINLIL_STORAGE_CONNECTION_STRING=Host=localhost;Database=ninlil;Username=ninlil;Password=change-me
NINLIL_ASPNETCORE_ENVIRONMENT=Production
