# systemd unit for the Arch Linux packages (ninlil, ninlil-git-stable, and ninlil-git-next) and the
# Deb and RPM packages (src/linux-packages), installed as /usr/lib/systemd/system/ninlil.service.
# The ninlil user comes from ninlil.sysusers, the executable lives in /usr/lib/ninlil and the
# optional environment file in /etc/ninlil.
[Unit]
Description=Ninlil DNS, DHCP and Router Advertisement server
Documentation=https://git.lantea.one/Lantea.One/ninlil
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=ninlil
Group=ninlil
# /var/lib/ninlil holds everything the server persists: the database, the Data Protection key
# ring, certificates, and the appsettings.json the admin console's settings pages write to.
# /usr/lib/ninlil/data is a symbolic link to it, because the server keeps its data directory next
# to the executable.
StateDirectory=ninlil
StateDirectoryMode=0700
WorkingDirectory=/var/lib/ninlil
# The package ships the web root empty, so the admin console built into the executable is
# served.
ExecStart=/usr/lib/ninlil/ninlil --contentRoot=/var/lib/ninlil --webroot=/usr/lib/ninlil/wwwroot
EnvironmentFile=-/etc/ninlil/ninlil.env
# The executable extracts its bundled native libraries on first start.
Environment=DOTNET_BUNDLE_EXTRACT_BASE_DIR=/var/lib/ninlil/.bundle
Restart=on-failure
RestartSec=5
# Ports below 1024 (53, 67, 80, 443, 547) without root, and raw sockets and interface access for
# DHCP and Router Advertisement.
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
