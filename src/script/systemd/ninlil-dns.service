# systemd unit for Ninlil installed by hand: install.sh copies it to /etc/systemd/system and
# creates the ninlil-dns user and the /opt/ninlil-dns layout it expects. The Arch Linux packages
# use src/archlinux/common/ninlil.service instead.
[Unit]
Description=Ninlil DNS, DHCP and Router Advertisement server
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=ninlil-dns
Group=ninlil-dns
WorkingDirectory=/opt/ninlil-dns
# The data directory doubles as the content root, so the appsettings.json the admin console's
# settings pages write to lands in the one writable directory, next to the database and keys.
# The web root is named explicitly so a published directory's wwwroot/ is still served; a
# single-file binary gets an empty wwwroot/ from install.sh and serves its built-in copy of the
# admin console instead.
ExecStart=/opt/ninlil-dns/Ninlil.Web --contentRoot=/opt/ninlil-dns/data --webroot=/opt/ninlil-dns/wwwroot
EnvironmentFile=-/etc/ninlil-dns/ninlil-dns.env
# A single-file binary extracts its bundled native libraries on first start; keep them inside
# the writable data directory, since install.sh creates no home directory for the account.
Environment=DOTNET_BUNDLE_EXTRACT_BASE_DIR=/opt/ninlil-dns/data/.bundle
Restart=on-failure
RestartSec=5
# Exit code 78 means Ninlil refused to start on purpose: the database was upgraded by a newer
# version, or a migration failed. Restarting cannot fix either, so systemd must not retry.
RestartPreventExitStatus=78
# Ports below 1024 (53, 67, 80, 443, 547) without root, and raw sockets and interface access for
# DHCP and Router Advertisement.
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# ProtectSystem=strict makes everything else read-only.
ReadWritePaths=/opt/ninlil-dns/data

[Install]
WantedBy=multi-user.target
