/**
 * This output block defines an output variable that provides the
 * contents of the NuGet.config file generated by this module.
 */
output "nuget-config" {
  description = "The contents of the NuGet.config file that was generated by this module."

  // Sensitive, because the file can hold source passwords in clear text.
  sensitive = true

  value = file(local.config-file)
}

/**
 * This output block defines an output variable that provides the
 * absolute path to the NuGet.config file generated by this module.
 */
output "nuget-config-file" {
  description = "The absolute path to the NuGet.config file that was generated by this module."

  value = local.config-file
}
