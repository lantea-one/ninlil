<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>
            This library provides our common serialization libraries that
            support the serialization functionality of the  application.
        </Description>
    <DocumentationFile>bin/$(Configuration)/$(TargetFramework)/$(AssemblyName).xml</DocumentationFile>
    <PackageId>Ninlil.Common.Serializer</PackageId>
    <RuntimeIdentifiers>
            linux-arm64;linux-x64;linux-musl-arm64;linux-musl-x64;osx-arm64;osx-x64;win-arm64;win-x64
        </RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <!--
      The MVC formatters, model binders and Swagger filters use types that ship inside the
      ASP.NET Core shared framework (Microsoft.AspNetCore.Mvc, .Http, .ModelBinding), so the
      library references the framework instead of the legacy Microsoft.AspNetCore.Mvc 2.3 NuGet
      package. Every Ninlil host already runs on that framework.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MimeKit" Version="4.17.0" />
    <!-- MimeKit 4.17 depends on Pkcs 10.0.0, which has known advisories; this pin lifts it. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- ListMapJsonConverter honours Newtonsoft's JsonPropertyAttribute on its key property. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore.Filters" Version="10.0.1" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.2.3" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
</Project>
