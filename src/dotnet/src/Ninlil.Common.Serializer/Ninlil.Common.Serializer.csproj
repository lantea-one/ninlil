<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Authors>frejagail</Authors>
    <Company>Ninlil</Company>
    <Description>
            This library provides our common serialization libraries that
            support the serialization functionality of the  application.
        </Description>
    <DocumentationFile>bin/$(Configuration)/$(TargetFramework)/$(AssemblyName).xml</DocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);1608;1701;1702;CS1591;NETSDK1194;NU1608;NU1701;NU1702;</NoWarn>
    <Nullable>disable</Nullable>
    <PackageId>Ninlil.Common.Serializer</PackageId>
    <RuntimeIdentifiers>
            linux-arm64;linux-x64;linux-musl-arm64;linux-musl-x64;osx-arm64;osx-x64;win-arm64;win-x64
        </RuntimeIdentifiers>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc" Version="2.3.12" />
    <PackageReference Include="MimeKit" Version="4.17.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageReference Include="Swashbuckle.AspNetCore.Filters" Version="10.0.1" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.2.3" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
</Project>
