<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>
            This library is Ninlil's DHCPv4 transport: an RFC 2131 UDP listener that binds the
            DHCP server port, decodes and encodes messages via Ninlil.Dhcp.Common, and hands every
            decision about how (or whether) to answer a request to whichever IDhcpv4RequestHandler
            dependency injection resolves. It knows nothing about lease allocation, reservations,
            or option delivery policy -- that belongs to whichever handler is registered.
        </Description>
    <PackageId>Ninlil.Dhcp.Protocol.Dhcpv4</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ninlil.Dhcp.Protocol.Dhcpv4.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference
      Include="Microsoft.Extensions.Options.ConfigurationExtensions"
      Version="10.0.11"
    />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageReference
      Include="Microsoft.Extensions.DependencyInjection.Abstractions"
      Version="10.0.11"
    />
  </ItemGroup>

  <!-- ConditionalPackageProject:Ninlil.Dhcp.Common -->
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' != 'false' And Exists('..\Ninlil.Dhcp.Common\Ninlil.Dhcp.Common.csproj')">
    <ProjectReference Include="..\Ninlil.Dhcp.Common\Ninlil.Dhcp.Common.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' == 'false' Or Exists('..\Ninlil.Dhcp.Common\Ninlil.Dhcp.Common.csproj')">
    <PackageReference Include="Ninlil.Dhcp.Common" Version="*" />
  </ItemGroup>
  <!-- EndConditionalPackageProject:Ninlil.Dhcp.Common -->
</Project>
