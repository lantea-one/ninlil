<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>
            This library is Ninlil's DNSSEC engine: the signing-algorithm abstraction, key
            management, and offline zone-signing pipeline behind RFC 4034/5155's chain-of-trust
            record types.
        </Description>
    <PackageId>Ninlil.Dns.Server.Dnssec</PackageId>
  </PropertyGroup>

  <!--
      Ed25519 and Ed448 (DNSSEC algorithms 15 and 16) have no BCL implementation as of .NET 10,
      confirmed by reflecting over System.Security.Cryptography's exported types, which expose
      RSA/DSA/ECDsa and the post-quantum MLDsa/SlhDsa families, but nothing named Ed25519, Ed448,
      or EdDsa. BouncyCastle.Cryptography is the one new dependency this project takes on, used
      only for those two algorithms; every other algorithm in the registry uses the BCL directly.
    -->
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
  </ItemGroup>

  <!--
      A plain class library, not an ASP.NET Core Web project, but it needs
      Microsoft.AspNetCore.DataProtection to encrypt a private key at rest, the same as
      Ninlil.Dns.Server.Tsig does for a TSIG shared secret. DataProtection ships inside the
      ASP.NET Core shared framework rather than as an ordinary NuGet package.
    -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- ConditionalPackageProject:Ninlil.Dns.Common -->
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' != 'false' And Exists('..\Ninlil.Dns.Common\Ninlil.Dns.Common.csproj')">
    <ProjectReference Include="..\Ninlil.Dns.Common\Ninlil.Dns.Common.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' == 'false' Or Exists('..\Ninlil.Dns.Common\Ninlil.Dns.Common.csproj')">
    <PackageReference Include="Ninlil.Dns.Common" Version="*" />
  </ItemGroup>
  <!-- EndConditionalPackageProject:Ninlil.Dns.Common -->

  <!-- ConditionalPackageProject:Ninlil.Dns.Data.Abstractions -->
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' != 'false' And Exists('..\Ninlil.Dns.Data.Abstractions\Ninlil.Dns.Data.Abstractions.csproj')">
    <ProjectReference Include="..\Ninlil.Dns.Data.Abstractions\Ninlil.Dns.Data.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' == 'false' Or Exists('..\Ninlil.Dns.Data.Abstractions\Ninlil.Dns.Data.Abstractions.csproj')">
    <PackageReference Include="Ninlil.Dns.Data.Abstractions" Version="*" />
  </ItemGroup>
  <!-- EndConditionalPackageProject:Ninlil.Dns.Data.Abstractions -->
</Project>
