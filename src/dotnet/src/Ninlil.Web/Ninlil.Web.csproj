<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <Description>
            This project is Ninlil's REST API host: Kestrel, OpenAPI/Swagger/ReDoc, the full
            Identity/Auth REST surface (login, refresh, 2FA, API tokens, user/role management), a
            SignalR hub bridging Server.Core's own internal event bus to authenticated real-time
            clients, and (since Phase 4d) the single combined host for the actual DNS engine
            itself: every resolver, every transport, and every already-built feature
            (filtering, rate limiting, TSIG, DNSSEC, ACME, cloud zone sync).
        </Description>
    <PackageId>Ninlil.Web</PackageId>
    <UserSecretsId>ninlil-dns-web</UserSecretsId>
  </PropertyGroup>

  <!--
      Swashbuckle.AspNetCore generates the OpenAPI document from this project's own controllers
      and XML doc comments, and serves Swagger UI. MIT licensed, mature, and integrates with the
      XML documentation file every project in this solution already generates
      (Directory.Build.props's own GenerateDocumentationFile).

      Swashbuckle.AspNetCore.Filters (a separate, third-party MIT-licensed package by a different
      author, not part of the core Swashbuckle project) adds the actual request/response EXAMPLE
      mechanism the core package has no equivalent of at all, namely IExamplesProvider{T} and
      IMultipleExamplesProvider{T}, plus the SwaggerRequestExample/SwaggerResponseExample action
      attributes this project's own new Examples/ folder implements. Its own minimum declared
      dependency is Swashbuckle.AspNetCore.SwaggerGen 10.0.0, comfortably satisfied by the
      10.2.3 already referenced above.
    -->
  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="Swashbuckle.AspNetCore.Filters" Version="10.0.1" />
  </ItemGroup>

