  <!--
      These properties and items back NinlilBuildAngularAdminSpa's Inputs and Outputs below.
      They must stay here, at the top level of the project, and not inside the target's body:
      MSBuild expands a target's Inputs and Outputs before the target's tasks run, so an item
      list that the target body creates is still empty at that point and the target would see
      zero inputs. A project-level ItemGroup is visible to them.
    -->
  <PropertyGroup>
    <!-- GetFullPath resolves the workspace path to an absolute one without ".." segments, so
         every item path built from it, and the RecursiveDir the Copy below uses, stays clean. -->
    <NinlilAngularWorkspaceDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../angular/'))</NinlilAngularWorkspaceDir>
    <NinlilAngularBuildOutputDir>$(NinlilAngularWorkspaceDir)dist/angular/browser/</NinlilAngularBuildOutputDir>
    <NinlilWebWwwrootDir>$(MSBuildThisFileDirectory)wwwroot/</NinlilWebWwwrootDir>
  </PropertyGroup>
  <!--
      NinlilSkipAngularBuild=true skips the NinlilBuildAngularAdminSpa target below entirely.
      The CI pipeline and the container image build the Angular workspace once, in their own
      step, and copy its output into wwwroot/ before invoking dotnet, so the target has nothing
      left to do there.

      NinlilEmbedWebRoot=true compiles every file under wwwroot/ into this assembly as an
      embedded resource, together with the manifest ManifestEmbeddedFileProvider reads. The
      release binaries use this: a single-file executable carries the admin console inside
      itself instead of needing a wwwroot/ directory beside it, and Program.cs falls back to the
      embedded copy whenever no physical wwwroot/index.html exists. wwwroot/ must already be
      populated when the project is evaluated, which is always true once the Angular output has
      been copied in ahead of the dotnet invocation.
    -->
  <PropertyGroup Condition="'$(NinlilEmbedWebRoot)' == 'true'">
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup Condition="'$(NinlilEmbedWebRoot)' == 'true'">
    <EmbeddedResource Include="wwwroot/**" />
  </ItemGroup>
  <ItemGroup>
    <NinlilAngularSourceFiles Include="$(NinlilAngularWorkspaceDir)src/**/*.*;$(NinlilAngularWorkspaceDir)angular.json;$(NinlilAngularWorkspaceDir)package.json;$(NinlilAngularWorkspaceDir)package-lock.json;$(NinlilAngularWorkspaceDir)openapi/swagger.json;$(NinlilAngularWorkspaceDir)tsconfig*.json" />
  </ItemGroup>

  <!--
      This target builds the Angular admin console (src/angular/) and copies its production build
      output into this project's wwwroot/ directory, so a plain `dotnet build` or `dotnet publish`
      of this one project produces a working combined host, without a separate
      `npm run build` step that a contributor could forget.

      It runs BeforeTargets="Build;Publish", so a `dotnet publish` alone still produces a
      populated wwwroot/. It must run before the build and not after it: the SDK's implicit
      `wwwroot/**` Content glob is evaluated once, when the project is evaluated and before any
      target runs, so an AfterTargets="Build" hook would fill wwwroot/ too late for that build's
      Content list. The explicit `<Content Include=...>` re-declaration in the target body covers
      the one case where that matters: the first build, when wwwroot/ does not exist at evaluation
      time. Later builds find wwwroot/ on disk and the implicit glob picks it up.

      The target's Inputs and Outputs keep a routine rebuild fast. NinlilAngularSourceFiles above is
      the Inputs; wwwroot/index.html is the Outputs sentinel. `npm install` and `npm run build`
      run only when an input is newer than the sentinel or the sentinel does not exist. MSBuild
      logs "skipping target ... because all output files are up-to-date" on every other rebuild.
      A missing npm never creates the sentinel, so the target runs again on every build, with only
      the cheap version check, and warns each time until npm is available.

      A missing npm on PATH produces a warning and an empty or stale wwwroot/, not a build
      failure. A contributor without Node.js can still build the backend, and CI builds the console
      in its own step (.forgejo/scripts/build-admin-console.sh) and passes
      -p:NinlilSkipAngularBuild=true. The exit code of the version check below decides this, not
      an exception: the shell that <Exec> launches ("/bin/sh -c" on Linux and macOS, "cmd.exe /c"
      on Windows) returns a nonzero exit code when it cannot find the command, and
      IgnoreExitCode="true" lets the target read that code instead of failing. The host still builds
      and runs without the console; it serves none until npm is available and the project is
      rebuilt. Once npm is present, a failing `npm install` or `npm run build` fails the dotnet
      build, like a compile error in any other project.
    -->
  <Target
    Name="NinlilBuildAngularAdminSpa"
    BeforeTargets="Build;Publish"
    Condition="'$(NinlilSkipAngularBuild)' != 'true'"
    Inputs="@(NinlilAngularSourceFiles)"
    Outputs="$(NinlilWebWwwrootDir)index.html"
  >
    <!-- Probe for npm on PATH. The comment above this target explains why the exit code, not an
         exception, decides the skip. -->
    <Exec
      Command="npm --version"
      IgnoreExitCode="true"
      StandardOutputImportance="Low"
      StandardErrorImportance="Low"
    >
      <Output TaskParameter="ExitCode" PropertyName="NinlilNpmProbeExitCode" />
    </Exec>

    <Warning
      Condition="'$(NinlilNpmProbeExitCode)' != '0'"
      Text="npm was not found on PATH, skipping the Angular admin SPA build (src/angular/). Ninlil.Web will still build and run, but wwwroot/ will be missing or stale and the admin SPA will not be served until npm is available and this project is rebuilt. Install Node.js/npm to build the admin SPA."
    />

    <Exec
      Condition="'$(NinlilNpmProbeExitCode)' == '0'"
      Command="npm install"
      WorkingDirectory="$(NinlilAngularWorkspaceDir)"
    />
    <Exec
      Condition="'$(NinlilNpmProbeExitCode)' == '0'"
      Command="npm run build"
      WorkingDirectory="$(NinlilAngularWorkspaceDir)"
    />

    <!-- A fresh copy every time, rather than an additive one, so a renamed/removed hashed bundle
         file from a prior build (Angular's own production build names every JS/CSS bundle after
         a content hash) never lingers in wwwroot/ forever. -->
    <RemoveDir
      Condition="'$(NinlilNpmProbeExitCode)' == '0' And Exists('$(NinlilWebWwwrootDir)')"
      Directories="$(NinlilWebWwwrootDir)"
    />
    <MakeDir Condition="'$(NinlilNpmProbeExitCode)' == '0'" Directories="$(NinlilWebWwwrootDir)" />

    <ItemGroup Condition="'$(NinlilNpmProbeExitCode)' == '0'">
      <NinlilAngularBuildOutputFiles Include="$(NinlilAngularBuildOutputDir)**/*.*" />
    </ItemGroup>
    <Copy
      Condition="'$(NinlilNpmProbeExitCode)' == '0'"
      SourceFiles="@(NinlilAngularBuildOutputFiles)"
      DestinationFolder="$(NinlilWebWwwrootDir)%(RecursiveDir)"
    />

    <!-- Re-declares the just-copied files as Content items for this build. The comment above this
         target explains why this matters only the first time wwwroot/ is populated. -->
    <ItemGroup Condition="'$(NinlilNpmProbeExitCode)' == '0'">
      <Content
        Include="$(NinlilWebWwwrootDir)**"
        CopyToPublishDirectory="PreserveNewest"
        CopyToOutputDirectory="PreserveNewest"
      />
    </ItemGroup>
  </Target>
  <!--
      A single-file Windows publish leaves msquic.dll out of the executable (the runtime pack marks
      it DropFromSingleFile) and out of the publish folder. System.Net.Quic loads it only from the
      folder of the executable, so DNS-over-QUIC needs the file beside the executable. This target
      copies the runtime pack's own msquic.dll (the one RuntimePackAsset names) into the publish
      folder; .forgejo/scripts/publish-binary.sh zips it with the executable.
    -->
  <Target
    Name="NinlilCopyMsQuicBesideExecutable"
    AfterTargets="Publish"
    Condition="'$(PublishSingleFile)' == 'true' and $(RuntimeIdentifier.StartsWith('win-'))"
  >
    <ItemGroup>
      <NinlilMsQuicAsset
        Include="@(RuntimePackAsset)"
        Condition="'%(Filename)%(Extension)' == 'msquic.dll'"
      />
    </ItemGroup>
    <Copy SourceFiles="@(NinlilMsQuicAsset)" DestinationFolder="$(PublishDir)" />
  </Target>
</Project>
