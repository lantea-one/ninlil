<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <Description>
            This project is the Ninlil server host. One process runs the DNS engine with every resolver
            and transport, the DHCP engine, the REST API (Kestrel, OpenAPI, Swagger and ReDoc) with
            sign-in, two-factor authentication, API tokens and user and role management, a SignalR hub
            that sends server events to signed-in clients, and the admin console.
        </Description>
    <PackageId>Ninlil.Web</PackageId>
    <UserSecretsId>ninlil-dns-web</UserSecretsId>
  </PropertyGroup>

  <!--
      Swashbuckle.AspNetCore generates the OpenAPI document from this project's own controllers
      and XML doc comments, and serves Swagger UI. MIT licensed, mature, and integrates with the
      XML documentation file every project in this solution already generates
      (Directory.Build.props's own GenerateDocumentationFile).

      Swashbuckle.AspNetCore.Filters (a separate, third-party MIT-licensed package by a different
      author, not part of the core Swashbuckle project) adds the request/response EXAMPLE
      mechanism the core package has no equivalent of, namely IExamplesProvider{T} and
      IMultipleExamplesProvider{T}, plus the SwaggerRequestExample/SwaggerResponseExample action
      attributes that the classes in this project's Examples/ folder use.
    -->
  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="Swashbuckle.AspNetCore.Filters" Version="10.0.1" />
  </ItemGroup>

