  <!--
      These properties/items back NinlilBuildAngularAdminSpa's own Inputs/Outputs below, and
      must live here, at the top level of the project (evaluated once, statically, before any
      target ever runs), not inside that target's own body. A first, working version of this
      defined NinlilAngularSourceFiles dynamically inside the target instead, and a real test
      build found the target's own Inputs/Outputs attributes had already been resolved against
      that item list back when the *project itself* was first evaluated, before the target that
      would have populated it ever ran, permanently seeing zero items no matter what the target
      body later added to that same item name. Target Inputs/Outputs are always resolved
      statically like this; only a project-level ItemGroup such as this one is visible to them.
    -->
  <PropertyGroup>
    <!-- Resolved to a clean, absolute, ".."-free path via GetFullPath, since an unresolved
         "../../../angular/" relative segment combined with a "**" recursive wildcard below was
         separately found, by that same real test build, to silently enumerate zero files
         instead of throwing or warning either. -->
    <NinlilAngularWorkspaceDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../angular/'))</NinlilAngularWorkspaceDir>
    <NinlilAngularBuildOutputDir>$(NinlilAngularWorkspaceDir)dist/angular/browser/</NinlilAngularBuildOutputDir>
    <NinlilWebWwwrootDir>$(MSBuildThisFileDirectory)wwwroot/</NinlilWebWwwrootDir>
  </PropertyGroup>
  <!--
      NinlilSkipAngularBuild=true skips the NinlilBuildAngularAdminSpa target below entirely.
      The CI pipeline and the container image build the Angular workspace once, in their own
      step, and copy its output into wwwroot/ before invoking dotnet, so the target has nothing
      left to do there.

      NinlilEmbedWebRoot=true compiles every file under wwwroot/ into this assembly as an
      embedded resource, together with the manifest ManifestEmbeddedFileProvider reads. The
      release binaries use this: a single-file executable carries the admin console inside
      itself instead of needing a wwwroot/ directory beside it, and Program.cs falls back to the
      embedded copy whenever no physical wwwroot/index.html exists. wwwroot/ must already be
      populated when the project is evaluated, which is always true once the Angular output has
      been copied in ahead of the dotnet invocation.
    -->
  <PropertyGroup Condition="'$(NinlilEmbedWebRoot)' == 'true'">
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup Condition="'$(NinlilEmbedWebRoot)' == 'true'">
    <EmbeddedResource Include="wwwroot/**" />
  </ItemGroup>
  <ItemGroup>
    <NinlilAngularSourceFiles Include="$(NinlilAngularWorkspaceDir)src/**/*.*;$(NinlilAngularWorkspaceDir)angular.json;$(NinlilAngularWorkspaceDir)package.json;$(NinlilAngularWorkspaceDir)package-lock.json;$(NinlilAngularWorkspaceDir)openapi/swagger.json;$(NinlilAngularWorkspaceDir)tsconfig*.json" />
  </ItemGroup>

  <!--
      This target builds Ninlil's Angular admin SPA (src/angular/, Phase 5) and copies its
      production build output into this project's own wwwroot/ directory, so a plain
      `dotnet build`/`dotnet publish` of this one project alone is enough to produce a working
      combined host, no separate "remember to run npm run build first" step an operator or CI
      job could forget. This is the same "single combined host, dotnet run and it just works"
      philosophy Phase 4d already established for the DNS engine itself, applied here to the
      admin SPA's own build step instead of a second runtime process.

      Runs BeforeTargets="Build" (and "Publish", so a plain `dotnet publish` alone, without a
      prior `dotnet build` in the same invocation, still produces a populated wwwroot/ too),
      not AfterTargets, because the SDK's own implicit `wwwroot/**` Content-item glob
      (Microsoft.NET.Sdk.Web's default item behavior) is evaluated once, statically, before any
      target ever runs, an AfterTargets="Build" hook would populate wwwroot/ too late for that
      same build's own Content-item list to ever notice. The explicit `<Content Include=...>`
      re-declaration inside this target's own body (below) exists specifically to patch that one
      gap for a *first* build, where wwwroot/ does not yet exist at evaluation time; every later
      build already has wwwroot/'s own prior output on disk before evaluation even starts, so the
      SDK's own implicit glob already picks it up correctly on its own from that point on.

      Kept fast on a routine, nothing-changed rebuild via this Target element's own native
      Inputs/Outputs incremental-build support (MSBuild's standard mechanism for this, not a
      hand-rolled timestamp comparison): NinlilAngularSourceFiles above is this target's
      Inputs; wwwroot/index.html is its Outputs sentinel. `npm install && npm run build` only
      actually runs when at least one input is newer than that sentinel (or the sentinel does
      not exist yet at all); MSBuild logs "skipping target ... because all output files are
      up-to-date" and does nothing further on every other rebuild. A missing npm also means the
      sentinel is never created, so this target (cheaply: just the version-check below) keeps
      retrying, and re-warning, on every single build until npm becomes available, rather than
      warning once and then silently staying skipped forever after.

      Gracefully degrades, rather than failing the whole dotnet build, when npm is not found on
      PATH at all: a contributor without Node.js installed, and this solution's own existing
      backend-only CI job (which has no Node step, and is not gaining one this pass, Phase 5's
      own CI-wiring decision was explicitly deferred to a later pass), must both still be able to
      build this project successfully. The trivial npm version-check invocation below's own exit
      code is what decides this, not a missing-executable exception a plain <Exec> would
      otherwise throw, since the shell <Exec> itself launches ("/bin/sh -c ..." on Linux/macOS,
      "cmd.exe /c ..." on Windows) already returns a well-defined, ordinary nonzero exit code
      (127, or 9009 respectively) when the command it was asked to run cannot be found at all,
      with IgnoreExitCode="true" simply letting this target read that code back instead of
      treating it as a hard failure. A missing npm only ever produces an MSBuild *warning* and an
      empty/stale wwwroot/ (this host still builds and runs, the SPA itself just is not served
      until npm becomes available and this project is rebuilt); it is deliberately NOT the same
      graceful handling extended to a real Angular build failure (a TypeScript error, a failing
      lint step if one is ever wired into `npm run build`): once npm is confirmed present,
      `npm install`/`npm run build`'s own exit code is allowed to fail the dotnet build normally,
      the same way a real compile error in any other project in this solution would.
    -->
  <Target
    Name="NinlilBuildAngularAdminSpa"
    BeforeTargets="Build;Publish"
    Condition="'$(NinlilSkipAngularBuild)' != 'true'"
    Inputs="@(NinlilAngularSourceFiles)"
    Outputs="$(NinlilWebWwwrootDir)index.html"
  >
    <!-- Probe for npm on PATH ourselves, see this target's own doc comment above for why its
         exit code, not an exception, is what this graceful-skip decision is based on. -->
    <Exec
      Command="npm --version"
      IgnoreExitCode="true"
      StandardOutputImportance="Low"
      StandardErrorImportance="Low"
    >
      <Output TaskParameter="ExitCode" PropertyName="NinlilNpmProbeExitCode" />
    </Exec>

    <Warning
      Condition="'$(NinlilNpmProbeExitCode)' != '0'"
      Text="npm was not found on PATH, skipping the Angular admin SPA build (src/angular/). Ninlil.Web will still build and run, but wwwroot/ will be missing or stale and the admin SPA will not be served until npm is available and this project is rebuilt. Install Node.js/npm to build the admin SPA."
    />

    <Exec
      Condition="'$(NinlilNpmProbeExitCode)' == '0'"
      Command="npm install"
      WorkingDirectory="$(NinlilAngularWorkspaceDir)"
    />
    <Exec
      Condition="'$(NinlilNpmProbeExitCode)' == '0'"
      Command="npm run build"
      WorkingDirectory="$(NinlilAngularWorkspaceDir)"
    />

    <!-- A fresh copy every time, rather than an additive one, so a renamed/removed hashed bundle
         file from a prior build (Angular's own production build names every JS/CSS bundle after
         a content hash) never lingers in wwwroot/ forever. -->
    <RemoveDir
      Condition="'$(NinlilNpmProbeExitCode)' == '0' And Exists('$(NinlilWebWwwrootDir)')"
      Directories="$(NinlilWebWwwrootDir)"
    />
    <MakeDir Condition="'$(NinlilNpmProbeExitCode)' == '0'" Directories="$(NinlilWebWwwrootDir)" />

    <ItemGroup Condition="'$(NinlilNpmProbeExitCode)' == '0'">
      <NinlilAngularBuildOutputFiles Include="$(NinlilAngularBuildOutputDir)**/*.*" />
    </ItemGroup>
    <Copy
      Condition="'$(NinlilNpmProbeExitCode)' == '0'"
      SourceFiles="@(NinlilAngularBuildOutputFiles)"
      DestinationFolder="$(NinlilWebWwwrootDir)%(RecursiveDir)"
    />

    <!-- Explicitly re-declares the just-copied files as Content items for *this* build, see
         this file's own doc comment above for exactly why this is needed only the first time
         wwwroot/ is populated, not on every later build. -->
    <ItemGroup Condition="'$(NinlilNpmProbeExitCode)' == '0'">
      <Content
        Include="$(NinlilWebWwwrootDir)**"
        CopyToPublishDirectory="PreserveNewest"
        CopyToOutputDirectory="PreserveNewest"
      />
    </ItemGroup>
  </Target>
</Project>
