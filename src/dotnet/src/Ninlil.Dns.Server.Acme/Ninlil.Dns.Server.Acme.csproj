<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>
            This library is Ninlil's ACME (RFC 8555) client: DNS-01-only certificate
            issuance and renewal, scoped to zones this server itself hosts, feeding
            Ninlil.Dns.Server.Core's own TlsCertificateLoader as a third certificate source
            alongside an operator-provided PFX and the self-signed fallback.
        </Description>
    <PackageId>Ninlil.Dns.Server.Acme</PackageId>
  </PropertyGroup>

  <!-- The tests drive the issuer against a fake CA handler and call BuildContactUris. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Ninlil.Dns.Server.Acme.Tests" />
  </ItemGroup>

  <!--
      Certes is an MIT-licensed, RFC 8555-compliant .NET ACME client (JOSE/JWS request signing,
      the full account/order/authorization/challenge state machine). Used here rather than
      hand-rolling that protocol from scratch, the same judgment call this project already made
      for AWSSDK.Route53 over hand-rolled AWS SigV4 signing. MIT licensed, not GPL, so none of
      this project's own clean-room restrictions (NOTICE.md, scoped to Technitium/dnsmasq) apply.
    -->
  <ItemGroup>
    <PackageReference Include="Certes" Version="3.0.4" />
  </ItemGroup>

  <!--
      AcmeAccountStore.cs needs Microsoft.AspNetCore.DataProtection, which ships inside the ASP.NET
      Core shared framework rather than as an ordinary NuGet package, the same FrameworkReference
      Ninlil.Dns.Server.Tsig/Server.DnsCrypt/Server.Authoritative already use for the
      identical reason.
    -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- ConditionalPackageProject:Ninlil.Dns.Common -->
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' != 'false' And Exists('..\Ninlil.Dns.Common\Ninlil.Dns.Common.csproj')">
    <ProjectReference Include="..\Ninlil.Dns.Common\Ninlil.Dns.Common.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' == 'false' Or Exists('..\Ninlil.Dns.Common\Ninlil.Dns.Common.csproj')">
    <PackageReference Include="Ninlil.Dns.Common" Version="*" />
  </ItemGroup>
  <!-- EndConditionalPackageProject:Ninlil.Dns.Common -->

  <!-- ConditionalPackageProject:Ninlil.Dns.Data.Abstractions -->
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' != 'false' And Exists('..\Ninlil.Dns.Data.Abstractions\Ninlil.Dns.Data.Abstractions.csproj')">
    <ProjectReference Include="..\Ninlil.Dns.Data.Abstractions\Ninlil.Dns.Data.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' == 'false' Or Exists('..\Ninlil.Dns.Data.Abstractions\Ninlil.Dns.Data.Abstractions.csproj')">
    <PackageReference Include="Ninlil.Dns.Data.Abstractions" Version="*" />
  </ItemGroup>
  <!-- EndConditionalPackageProject:Ninlil.Dns.Data.Abstractions -->

  <!-- ConditionalPackageProject:Ninlil.Dns.Server.Core -->
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' != 'false' And Exists('..\Ninlil.Dns.Server.Core\Ninlil.Dns.Server.Core.csproj')">
    <ProjectReference Include="..\Ninlil.Dns.Server.Core\Ninlil.Dns.Server.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' == 'false' Or Exists('..\Ninlil.Dns.Server.Core\Ninlil.Dns.Server.Core.csproj')">
    <PackageReference Include="Ninlil.Dns.Server.Core" Version="*" />
  </ItemGroup>
  <!-- EndConditionalPackageProject:Ninlil.Dns.Server.Core -->

  <!-- ConditionalPackageProject:Ninlil.Dns.Server.Authoritative -->
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' != 'false' And Exists('..\Ninlil.Dns.Server.Authoritative\Ninlil.Dns.Server.Authoritative.csproj')">
    <ProjectReference Include="..\Ninlil.Dns.Server.Authoritative\Ninlil.Dns.Server.Authoritative.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' == 'false' Or Exists('..\Ninlil.Dns.Server.Authoritative\Ninlil.Dns.Server.Authoritative.csproj')">
    <PackageReference Include="Ninlil.Dns.Server.Authoritative" Version="*" />
  </ItemGroup>
  <!-- EndConditionalPackageProject:Ninlil.Dns.Server.Authoritative -->
</Project>
