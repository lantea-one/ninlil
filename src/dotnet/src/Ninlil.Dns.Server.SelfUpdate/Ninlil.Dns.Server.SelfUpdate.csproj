<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>
            This library is Ninlil's self-update checker: a periodic, check-only comparison of
            this host's own running version against whatever an operator-configured release feed
            reports, surfaced as a real REST/UI notice -- never an automatic in-place binary
            replacement. See SelfUpdateOptions's own doc comment for why applying an update always
            stays a distinct, manual operator action.
        </Description>
    <PackageId>Ninlil.Dns.Server.SelfUpdate</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
  </ItemGroup>

  <!-- The tests check the due rule in SelfUpdateCheckService directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Ninlil.Dns.Server.SelfUpdate.Tests" />
  </ItemGroup>

  <!-- ConditionalPackageProject:Ninlil.Dns.Common -->
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' != 'false' And Exists('..\Ninlil.Dns.Common\Ninlil.Dns.Common.csproj')">
    <ProjectReference Include="..\Ninlil.Dns.Common\Ninlil.Dns.Common.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' == 'false' Or Exists('..\Ninlil.Dns.Common\Ninlil.Dns.Common.csproj')">
    <PackageReference Include="Ninlil.Dns.Common" Version="*" />
  </ItemGroup>
  <!-- EndConditionalPackageProject:Ninlil.Dns.Common -->
</Project>
