<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>
            This library is Phase 9-6c's operational config sync: the receiving-side appliers
            (IClusterConfigSyncApplier, one per synced category: filter lists, filter list
            entries, access-control rules, rewrites, forwarders) and the event subscribers that
            forward a local write to every cluster peer via Ninlil.Dns.Server.Core's own
            IClusterConfigSyncBroadcaster abstraction. Deliberately its own project, separate
            from each entity's own owning engine project (Server.Filtering/Server.AccessControl/
            Server.Rewrites/Server.Forwarding), since none of those engine projects otherwise has
            any reason to know clustering exists at all; their own query-time engines read
            straight from a repository on every call and have nothing to invalidate.
        </Description>
    <PackageId>Ninlil.Dns.Server.ClusterSync</PackageId>
  </PropertyGroup>

  <!--
      Phase 9-6d's own UserClusterConfigSyncApplier/UserClusterSyncEventSubscriber need
      Microsoft.AspNetCore.DataProtection's IDataProtectionProvider/IDataProtector to
      decrypt-at-sender/re-encrypt-at-receiver a user's TOTP secret/recovery codes during a
      cluster sync; it ships inside the ASP.NET Core shared framework rather than as an ordinary
      NuGet package, the same reasoning Ninlil.Dns.Server.Tsig's own csproj already documents for
      TsigSecretProtector.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- ConditionalPackageProject:Ninlil.Dns.Common -->
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' != 'false' And Exists('..\Ninlil.Dns.Common\Ninlil.Dns.Common.csproj')">
    <ProjectReference Include="..\Ninlil.Dns.Common\Ninlil.Dns.Common.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' == 'false' Or Exists('..\Ninlil.Dns.Common\Ninlil.Dns.Common.csproj')">
    <PackageReference Include="Ninlil.Dns.Common" Version="*" />
  </ItemGroup>
  <!-- EndConditionalPackageProject:Ninlil.Dns.Common -->

  <!-- ConditionalPackageProject:Ninlil.Dns.Data.Abstractions -->
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' != 'false' And Exists('..\Ninlil.Dns.Data.Abstractions\Ninlil.Dns.Data.Abstractions.csproj')">
    <ProjectReference Include="..\Ninlil.Dns.Data.Abstractions\Ninlil.Dns.Data.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' == 'false' Or Exists('..\Ninlil.Dns.Data.Abstractions\Ninlil.Dns.Data.Abstractions.csproj')">
    <PackageReference Include="Ninlil.Dns.Data.Abstractions" Version="*" />
  </ItemGroup>
  <!-- EndConditionalPackageProject:Ninlil.Dns.Data.Abstractions -->

  <!-- ConditionalPackageProject:Ninlil.Dns.Server.Core -->
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' != 'false' And Exists('..\Ninlil.Dns.Server.Core\Ninlil.Dns.Server.Core.csproj')">
    <ProjectReference Include="..\Ninlil.Dns.Server.Core\Ninlil.Dns.Server.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' == 'false' Or Exists('..\Ninlil.Dns.Server.Core\Ninlil.Dns.Server.Core.csproj')">
    <PackageReference Include="Ninlil.Dns.Server.Core" Version="*" />
  </ItemGroup>
  <!-- EndConditionalPackageProject:Ninlil.Dns.Server.Core -->

  <!--
      Phase 9-6d's own identity/RBAC federation (UserClusterConfigSyncApplier/
      UserClusterSyncEventSubscriber) needs the exact same IDataProtector purpose strings
      Ninlil.Dns.Identity's own NinlilDnsUserStore uses for a TOTP authenticator key/recovery-code
      set, so a decrypt-at-sender/re-encrypt-at-receiver round trip actually lands on the same
      protected value a real sign-in later reads back. Referencing Identity directly (rather than
      duplicating those two magic purpose strings here) is safe; Identity has no dependency on
      clustering or this project at all, so there is no reference cycle.
  -->
  <!-- ConditionalPackageProject:Ninlil.Dns.Identity -->
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' != 'false' And Exists('..\Ninlil.Dns.Identity\Ninlil.Dns.Identity.csproj')">
    <ProjectReference Include="..\Ninlil.Dns.Identity\Ninlil.Dns.Identity.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' == 'false' Or Exists('..\Ninlil.Dns.Identity\Ninlil.Dns.Identity.csproj')">
    <PackageReference Include="Ninlil.Dns.Identity" Version="*" />
  </ItemGroup>
  <!-- EndConditionalPackageProject:Ninlil.Dns.Identity -->

  <!--
      This project's own sending-side subscribers need this node's own ClusterOptions.NodeId
      (to stamp an outbound envelope's own OriginatingNodeId for a deletion, where there is no
      longer a local entity row left to read it back from): the one reason this otherwise
      entity-focused project references Server.Cluster at all. It never implements
      IClusterConfigSyncBroadcaster itself (that stays Server.Cluster's own real
      implementation, referenced here only through Server.Core's abstraction).
  -->
  <!-- ConditionalPackageProject:Ninlil.Dns.Server.Cluster -->
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' != 'false' And Exists('..\Ninlil.Dns.Server.Cluster\Ninlil.Dns.Server.Cluster.csproj')">
    <ProjectReference Include="..\Ninlil.Dns.Server.Cluster\Ninlil.Dns.Server.Cluster.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' == 'false' Or Exists('..\Ninlil.Dns.Server.Cluster\Ninlil.Dns.Server.Cluster.csproj')">
    <PackageReference Include="Ninlil.Dns.Server.Cluster" Version="*" />
  </ItemGroup>
  <!-- EndConditionalPackageProject:Ninlil.Dns.Server.Cluster -->
</Project>
