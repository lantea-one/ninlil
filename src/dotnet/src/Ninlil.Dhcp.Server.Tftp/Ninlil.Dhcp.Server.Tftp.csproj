<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>
            This library is Ninlil's read-only RFC 1350 TFTP server -- the bundled boot-file
            delivery half of this project's own PXE support, matching dnsmasq's own bundled
            checklist behavior. Serves files from a single configured root directory; a Write
            Request is always rejected, and a request naming a path outside that root is always
            rejected. Shares no wire format or transport concept with DHCPv4/DHCPv6 -- its only
            dependency on another Ninlil.Dhcp.* project is Ninlil.Dhcp.Common's own
            IDhcpProtocolService contract, the shared runtime start/stop interface every
            DHCP-family transport in this project implements.
        </Description>
    <PackageId>Ninlil.Dhcp.Server.Tftp</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference
      Include="Microsoft.Extensions.Options.ConfigurationExtensions"
      Version="10.0.11"
    />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageReference
      Include="Microsoft.Extensions.DependencyInjection.Abstractions"
      Version="10.0.11"
    />
  </ItemGroup>

  <!-- ConditionalPackageProject:Ninlil.Dhcp.Common -->
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' != 'false' And Exists('..\Ninlil.Dhcp.Common\Ninlil.Dhcp.Common.csproj')">
    <ProjectReference Include="..\Ninlil.Dhcp.Common\Ninlil.Dhcp.Common.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' == 'false' Or Exists('..\Ninlil.Dhcp.Common\Ninlil.Dhcp.Common.csproj')">
    <PackageReference Include="Ninlil.Dhcp.Common" Version="*" />
  </ItemGroup>
  <!-- EndConditionalPackageProject:Ninlil.Dhcp.Common -->
</Project>
