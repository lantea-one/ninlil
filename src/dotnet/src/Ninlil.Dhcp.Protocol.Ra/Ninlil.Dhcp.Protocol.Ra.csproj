<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>
            This library is Ninlil's Router Advertisement transport: a raw ICMPv6 listener (RFC
            4861 Sections 4.1, 4.2 and 6.2) that binds a SOCK_RAW/IPPROTO_ICMPV6 socket on every
            usable network interface, joins the all-routers multicast group (RFC 4861 Section 6.2.2)
            to receive Router Solicitations, sends an unsolicited Router Advertisement at the
            randomized interval of Section 6.2.4, answers a solicitation after the random delay of
            Section 6.2.6, and encodes and decodes every message through Ninlil.Dhcp.Common. It
            does not decide what a Router Advertisement contains: the IRaAdvertisementProvider
            that dependency injection resolves does.
        </Description>
    <PackageId>Ninlil.Dhcp.Protocol.Ra</PackageId>
  </PropertyGroup>

  <!-- The tests call the advertisement builder and the solicitation filter directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Ninlil.Dhcp.Server.Ra.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference
      Include="Microsoft.Extensions.Options.ConfigurationExtensions"
      Version="10.0.11"
    />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageReference
      Include="Microsoft.Extensions.DependencyInjection.Abstractions"
      Version="10.0.11"
    />
  </ItemGroup>

  <!-- ConditionalPackageProject:Ninlil.Dhcp.Common -->
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' != 'false' And Exists('..\Ninlil.Dhcp.Common\Ninlil.Dhcp.Common.csproj')">
    <ProjectReference Include="..\Ninlil.Dhcp.Common\Ninlil.Dhcp.Common.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' == 'false' Or Exists('..\Ninlil.Dhcp.Common\Ninlil.Dhcp.Common.csproj')">
    <PackageReference Include="Ninlil.Dhcp.Common" Version="*" />
  </ItemGroup>
  <!-- EndConditionalPackageProject:Ninlil.Dhcp.Common -->
</Project>
