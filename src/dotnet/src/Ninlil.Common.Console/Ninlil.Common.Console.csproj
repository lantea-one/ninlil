<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Authors>frejagail</Authors>
    <Company>Ninlil</Company>
    <Description>
            This library provides our common libraries that support
            the console (CLI) functionality of the application.
        </Description>
    <DocumentationFile>bin/$(Configuration)/$(TargetFramework)/$(AssemblyName).xml</DocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);1608;1701;1702;CS1591;NETSDK1194;NU1608;NU1701;NU1702;</NoWarn>
    <Nullable>disable</Nullable>
    <PackageId>Ninlil.Common.Console</PackageId>
    <RootNamespace>Ninlil.Common.Console</RootNamespace>
    <RuntimeIdentifiers>
            linux-arm64;linux-x64;linux-musl-arm64;linux-musl-x64;osx-arm64;osx-x64;win-arm64;win-x64
        </RuntimeIdentifiers>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- ConditionalPackageProject:Ninlil.Common.Extension -->
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' != 'false' And Exists('..\Ninlil.Common.Extension\Ninlil.Common.Extension.csproj')">
    <ProjectReference
      Condition="Exists('..\Ninlil.Common.Extension\Ninlil.Common.Extension.csproj')"
      Include="..\Ninlil.Common.Extension\Ninlil.Common.Extension.csproj"
    />
  </ItemGroup>
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' == 'false' Or !Exists('..\Ninlil.Common.Extension\Ninlil.Common.Extension.csproj')">
    <PackageReference Include="Ninlil.Common.Extension" Version="*" />
  </ItemGroup>
  <!-- EndConditionalPackageProject:Ninlil.Common.Extension -->

  <ItemGroup>
    <PackageReference Include="ConsoleTables" Version="2.7.0" />
  </ItemGroup>
</Project>
