<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>
            This library is Ninlil's DNSCrypt engine: certificate generation/rotation and
            the client/resolver query-and-response encryption the DNSCrypt v2 protocol needs.
        </Description>
    <PackageId>Ninlil.Dns.Server.DnsCrypt</PackageId>
    <!-- NativeLibsodium.cs's LibraryImportAttribute declarations need this: the source
         generator itself emits unsafe code (pinning byte[] arguments) even though nothing in
         this project's own code uses unsafe/pointer syntax directly. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
      DNSCrypt's currently-normative cipher (es-version 0x0002, "Box-XChaChaPoly") needs
      XChaCha20-Poly1305 in the exact NaCl secretbox-style combined-mode layout the DNSCrypt spec
      itself is defined against, confirmed, by direct reflection over the shipped assembly,
      that BouncyCastle.Cryptography (this project's usual audited-crypto source) has no
      XChaCha20/HChaCha20 type at all. Sodium.Core is a binding to the real, heavily-audited
      libsodium C library, which does implement exactly this (its own transitive `libsodium`
      NuGet dependency ships native binaries for every RID this project already targets).
      Sodium.Core's own C# wrapper does not happen to expose the specific
      `crypto_box_curve25519xchacha20poly1305_*` functions DNSCrypt needs, though, see
      NativeLibsodium.cs, which supplements it with a handful of thin LibraryImport
      declarations targeting the exact same already-bundled, already-audited native library
      (not new, unaudited crypto math, the same approach Sodium.Core's own wrapper classes
      use internally, just for a few more of the functions the real libsodium.so already
      exports). Legacy es-version 0x0001 (XSalsa20-Poly1305) is fully covered by Sodium.Core's
      own PublicKeyBox class directly, no supplementing needed.
    -->
  <ItemGroup>
    <PackageReference Include="Sodium.Core" Version="1.4.1" />
  </ItemGroup>

  <!-- ConditionalPackageProject:Ninlil.Dns.Common -->
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' != 'false' And Exists('..\Ninlil.Dns.Common\Ninlil.Dns.Common.csproj')">
    <ProjectReference Include="..\Ninlil.Dns.Common\Ninlil.Dns.Common.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' == 'false' Or Exists('..\Ninlil.Dns.Common\Ninlil.Dns.Common.csproj')">
    <PackageReference Include="Ninlil.Dns.Common" Version="*" />
  </ItemGroup>
  <!-- EndConditionalPackageProject:Ninlil.Dns.Common -->

  <!-- ConditionalPackageProject:Ninlil.Dns.Server.Dnssec -->
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' != 'false' And Exists('..\Ninlil.Dns.Server.Dnssec\Ninlil.Dns.Server.Dnssec.csproj')">
    <ProjectReference Include="..\Ninlil.Dns.Server.Dnssec\Ninlil.Dns.Server.Dnssec.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' == 'false' Or Exists('..\Ninlil.Dns.Server.Dnssec\Ninlil.Dns.Server.Dnssec.csproj')">
    <PackageReference Include="Ninlil.Dns.Server.Dnssec" Version="*" />
  </ItemGroup>
  <!-- EndConditionalPackageProject:Ninlil.Dns.Server.Dnssec -->
</Project>
