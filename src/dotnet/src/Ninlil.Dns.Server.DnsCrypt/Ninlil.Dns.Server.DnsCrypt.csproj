<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>
            This library is Ninlil's DNSCrypt engine: certificate generation/rotation and
            the client/resolver query-and-response encryption the DNSCrypt v2 protocol needs.
        </Description>
    <PackageId>Ninlil.Dns.Server.DnsCrypt</PackageId>
    <!-- NativeLibsodium.cs's LibraryImportAttribute declarations need this: the source
         generator itself emits unsafe code (pinning byte[] arguments) even though nothing in
         this project's own code uses unsafe/pointer syntax directly. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
      DNSCrypt es-version 0x0002 (X25519-XChaCha20Poly1305) needs the libsodium function family
      crypto_box_curve25519xchacha20poly1305_*. Sodium.Core binds the libsodium C library, and
      its libsodium NuGet dependency ships the native binary for each runtime identifier this
      project targets. Sodium.Core's C# wrapper does not expose those functions, so
      NativeLibsodium.cs declares them with LibraryImport against the same native library. This
      project implements no cryptography of its own. Es-version 0x0001 (XSalsa20-Poly1305) goes
      through Sodium.Core's PublicKeyBox class directly.
        -->
  <ItemGroup>
    <PackageReference Include="Sodium.Core" Version="1.4.1" />
  </ItemGroup>

  <!-- ConditionalPackageProject:Ninlil.Dns.Common -->
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' != 'false' And Exists('..\Ninlil.Dns.Common\Ninlil.Dns.Common.csproj')">
    <ProjectReference Include="..\Ninlil.Dns.Common\Ninlil.Dns.Common.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' == 'false' Or Exists('..\Ninlil.Dns.Common\Ninlil.Dns.Common.csproj')">
    <PackageReference Include="Ninlil.Dns.Common" Version="*" />
  </ItemGroup>
  <!-- EndConditionalPackageProject:Ninlil.Dns.Common -->

  <!-- ConditionalPackageProject:Ninlil.Dns.Server.Dnssec -->
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' != 'false' And Exists('..\Ninlil.Dns.Server.Dnssec\Ninlil.Dns.Server.Dnssec.csproj')">
    <ProjectReference Include="..\Ninlil.Dns.Server.Dnssec\Ninlil.Dns.Server.Dnssec.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' == 'false' Or Exists('..\Ninlil.Dns.Server.Dnssec\Ninlil.Dns.Server.Dnssec.csproj')">
    <PackageReference Include="Ninlil.Dns.Server.Dnssec" Version="*" />
  </ItemGroup>
  <!-- EndConditionalPackageProject:Ninlil.Dns.Server.Dnssec -->
</Project>
