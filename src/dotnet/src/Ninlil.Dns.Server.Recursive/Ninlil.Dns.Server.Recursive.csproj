<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>
            This library is Ninlil's recursive DNS engine: an iterative, validating resolver
            that follows referrals from the root down, caches what it learns, and verifies the
            RFC 4035 DNSSEC chain of trust along the way.
        </Description>
    <PackageId>Ninlil.Dns.Server.Recursive</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference
      Include="Microsoft.Extensions.Options.ConfigurationExtensions"
      Version="10.0.11"
    />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageReference
      Include="Microsoft.Extensions.DependencyInjection.Abstractions"
      Version="10.0.11"
    />
  </ItemGroup>

  <!-- ConditionalPackageProject:Ninlil.Dns.Server.Core -->
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' != 'false' And Exists('..\Ninlil.Dns.Server.Core\Ninlil.Dns.Server.Core.csproj')">
    <ProjectReference Include="..\Ninlil.Dns.Server.Core\Ninlil.Dns.Server.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' == 'false' Or Exists('..\Ninlil.Dns.Server.Core\Ninlil.Dns.Server.Core.csproj')">
    <PackageReference Include="Ninlil.Dns.Server.Core" Version="*" />
  </ItemGroup>
  <!-- EndConditionalPackageProject:Ninlil.Dns.Server.Core -->

  <!-- ConditionalPackageProject:Ninlil.Dns.Server.Dnssec -->
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' != 'false' And Exists('..\Ninlil.Dns.Server.Dnssec\Ninlil.Dns.Server.Dnssec.csproj')">
    <ProjectReference Include="..\Ninlil.Dns.Server.Dnssec\Ninlil.Dns.Server.Dnssec.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(USE_LOCAL_INCLUDES)' == 'false' Or Exists('..\Ninlil.Dns.Server.Dnssec\Ninlil.Dns.Server.Dnssec.csproj')">
    <PackageReference Include="Ninlil.Dns.Server.Dnssec" Version="*" />
  </ItemGroup>
  <!-- EndConditionalPackageProject:Ninlil.Dns.Server.Dnssec -->
</Project>
