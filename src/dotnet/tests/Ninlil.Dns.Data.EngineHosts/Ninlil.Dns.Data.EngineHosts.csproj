<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
      This library holds the database hosts (containers and files) that the integration tests
      and the benchmarks share. It references no test SDK, so "dotnet test" skips it.
  -->
