<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
      This library holds the database hosts (containers and files) that the integration tests
      and the benchmarks share. It references no test SDK, so "dotnet test" skips it.
  -->
  <ItemGroup>
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />
    <PackageReference Include="Testcontainers.MySql" Version="4.14.0" />
    <PackageReference Include="Testcontainers.MsSql" Version="4.14.0" />
    <PackageReference Include="Testcontainers.MongoDb" Version="4.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ninlil.Dns.Common\Ninlil.Dns.Common.csproj" />
    <ProjectReference Include="..\..\src\Ninlil.Dns.Data.Abstractions\Ninlil.Dns.Data.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Ninlil.Dns.Data.EntityFrameworkCore\Ninlil.Dns.Data.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\src\Ninlil.Dns.Data.MongoDb\Ninlil.Dns.Data.MongoDb.csproj" />
    <ProjectReference Include="..\..\src\Ninlil.Dhcp.Data.EntityFrameworkCore\Ninlil.Dhcp.Data.EntityFrameworkCore.csproj" />
    <!-- The EF provider assemblies are loaded by name at run time, so nothing else pulls them in. -->
    <ProjectReference Include="..\..\src\Ninlil.Dns.Data.EntityFrameworkCore.Migrations.Sqlite\Ninlil.Dns.Data.EntityFrameworkCore.Migrations.Sqlite.csproj" />
    <ProjectReference Include="..\..\src\Ninlil.Dns.Data.EntityFrameworkCore.Migrations.PostgreSql\Ninlil.Dns.Data.EntityFrameworkCore.Migrations.PostgreSql.csproj" />
    <ProjectReference Include="..\..\src\Ninlil.Dns.Data.EntityFrameworkCore.Migrations.MySql\Ninlil.Dns.Data.EntityFrameworkCore.Migrations.MySql.csproj" />
    <ProjectReference Include="..\..\src\Ninlil.Dns.Data.EntityFrameworkCore.Migrations.SqlServer\Ninlil.Dns.Data.EntityFrameworkCore.Migrations.SqlServer.csproj" />
    <ProjectReference Include="..\..\src\Ninlil.Dhcp.Data.MongoDb\Ninlil.Dhcp.Data.MongoDb.csproj" />
  </ItemGroup>
</Project>
