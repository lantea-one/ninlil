<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ninlil.Dns.Common\Ninlil.Dns.Common.csproj" />
    <ProjectReference Include="..\..\src\Ninlil.Dns.Data.Abstractions\Ninlil.Dns.Data.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Ninlil.Dns.Data.EntityFrameworkCore\Ninlil.Dns.Data.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\src\Ninlil.Dns.Server.Core\Ninlil.Dns.Server.Core.csproj" />
    <ProjectReference Include="..\..\src\Ninlil.Dns.Server.Authoritative\Ninlil.Dns.Server.Authoritative.csproj" />
    <ProjectReference Include="..\..\src\Ninlil.Dns.Server.Presets\Ninlil.Dns.Server.Presets.csproj" />
    <!-- Referenced only for Server.Recursive's DNSSEC validation primitives
         (RrsetSignatureVerifier and DenialOfExistenceValidator). The rollover tests use them to
         prove a rollover never serves a bogus signature, and the NSEC3 Opt-Out tests use them to
         prove that a validator accepts this zone's Opt-Out chain, not merely that the bit is set.
         No src project depends on Server.Recursive this way; this is test-only. -->
    <ProjectReference Include="..\..\src\Ninlil.Dns.Server.Recursive\Ninlil.Dns.Server.Recursive.csproj" />
    <!-- Referenced only so SecondaryForwarderZoneTransferTests can run a real TcpDnsListener on
         its own primary-side test host: a real two-process-shaped AXFR/IXFR pull, over a real
         loopback TCP socket, between two independent IHost instances. No src project under test
         depends on a transport project (the dependency runs the other way in production), so this
         is test-only, the same reasoning already given for the Server.Recursive reference above. -->
    <ProjectReference Include="..\..\src\Ninlil.Dns.Protocol.Plain\Ninlil.Dns.Protocol.Plain.csproj" />
  </ItemGroup>
</Project>
