<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.19" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The signed-hierarchy fixture and its fakes are shared with the Recursive tests by linking the
       files, so the forwarder's DNSSEC tests walk the same signed root, com and example.com. -->
  <ItemGroup>
    <Compile
      Include="..\Ninlil.Dns.Server.Recursive.Tests\Support\*.cs"
      LinkBase="Shared\Support"
    />
    <Compile
      Include="..\Ninlil.Dns.Server.Recursive.Tests\Fakes\FakeUpstreamDnsClient.cs"
      LinkBase="Shared\Fakes"
    />
    <Compile
      Include="..\Ninlil.Dns.Server.Recursive.Tests\Fakes\FakeTrustAnchorStore.cs"
      LinkBase="Shared\Fakes"
    />
    <Compile
      Include="..\Ninlil.Dns.Server.Recursive.Tests\Fakes\StaticOptionsMonitor.cs"
      LinkBase="Shared\Fakes"
    />
    <Compile
      Include="..\Ninlil.Dns.Server.Recursive.Tests\Fakes\RecordingEventPublisher.cs"
      LinkBase="Shared\Fakes"
    />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ninlil.Dns.Common\Ninlil.Dns.Common.csproj" />
    <ProjectReference Include="..\..\src\Ninlil.Dns.Data.Abstractions\Ninlil.Dns.Data.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Ninlil.Dns.Data.EntityFrameworkCore\Ninlil.Dns.Data.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\src\Ninlil.Dns.Server.Core\Ninlil.Dns.Server.Core.csproj" />
    <ProjectReference Include="..\..\src\Ninlil.Dns.Server.Dnssec\Ninlil.Dns.Server.Dnssec.csproj" />
    <ProjectReference Include="..\..\src\Ninlil.Dns.Server.DnsCrypt\Ninlil.Dns.Server.DnsCrypt.csproj" />
    <ProjectReference Include="..\..\src\Ninlil.Dns.Server.Recursive\Ninlil.Dns.Server.Recursive.csproj" />
    <ProjectReference Include="..\..\src\Ninlil.Dns.Protocol.DnsCrypt\Ninlil.Dns.Protocol.DnsCrypt.csproj" />
    <ProjectReference Include="..\..\src\Ninlil.Dns.Protocol.Plain\Ninlil.Dns.Protocol.Plain.csproj" />
    <ProjectReference Include="..\..\src\Ninlil.Dns.Server.Forwarding\Ninlil.Dns.Server.Forwarding.csproj" />
    <ProjectReference Include="..\..\src\Ninlil.Dns.Server.Filtering\Ninlil.Dns.Server.Filtering.csproj" />
  </ItemGroup>
</Project>
