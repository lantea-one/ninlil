# Trims the build context sent to the daemon for the root Dockerfile. The image build copies only
# docker/fetch-native-libraries.sh and docker/native-libraries.lock from this context (the
# executables come from the separate "binaries" build context), so these exclusions keep the
# upload small and keep local state, such as an appsettings.json, out of the daemon.

# Git metadata and CI configuration: unused by the build, and often large.
.git/
.forgejo/

# Release binaries and Linux packages the pipeline collects in dist/ and packages/. The image
# gets the executables through the separate "binaries" build context.
dist/
packages/

# .NET build output: every project's bin/ and obj/, matching .gitignore's [Bb]in/ and [Oo]bj/.
**/bin/
**/obj/

# Local tool and agent state: the Angular cache at the repository root, agent settings and the
# dotnet local tool manifest. None of it is used by the build.
.angular/
.claude/
.config/

# Packaging and operations files the image does not use: Arch packages, Terraform modules and the
# installer and database scripts.
src/archlinux/
src/terraform/
src/script/

# Angular dependencies and build output. node_modules/ alone is several hundred MB and would
# dominate the build context.
src/angular/node_modules/
src/angular/dist/
src/angular/.angular/

# The admin console's build output, copied here by the NinlilBuildAngularAdminSpa MSBuild target
# or build-admin-console.sh. The image serves the copy embedded in the executable instead.
src/dotnet/src/Ninlil.Web/wwwroot/

# Local configuration and secrets, never committed (see .gitignore). The container is configured
# through environment variables and the appsettings.json in its data volume instead.
appsettings.json
appsettings.*.json
**/appsettings.json
**/appsettings.*.json

# Local code-coverage and test output.
coverage-raw/
coverage-report/
TestResults/
**/TestResults/

# IDE and editor state.
.idea/
.vs/
.vscode/

# Other local-only files, also excluded from git.
.playwright-mcp/
*.log
nuget-cache/
docker-nuget-feed/

# The builder reads these two files separately, so they need not be in the context.
Dockerfile
.dockerignore
